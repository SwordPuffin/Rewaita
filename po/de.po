msgstr "Transparentes oberes Panel"

#: src/widgets/extra_options_box.py:121
msgid "Makes the Top Panel Background Transparent"
msgstr "Macht den Hintergrund des oberen Panels transparent"

#: src/widgets/extra_options_box.py:126
msgid "Reduce Rounding on Pill Buttons"
msgstr "Rundung von Pillen-Schaltflächen reduzieren"

#: src/widgets/extra_options_box.py:127
